# ============================================================================
# YardSquare — Environment Variables Template (`.env.example`)
# Zero hardcoded values or secrets in source code. Copy to `.env` for local overrides.
# ============================================================================

ENV=dev
APP_NAME=YardSquare
API_VERSION=1.0.0
PORT=8080

# Google Cloud Platform Configuration
GCP_PROJECT_ID=
FIRESTORE_DATABASE=(default)
FIRESTORE_COLLECTION_PREFIX=dev_
GCS_BUCKET_NAME=
USE_GCP_SECRET_MANAGER=false

# External API URLs (Configurable, never hardcoded in logic)
PHOTON_AUTOCOMPLETE_URL=https://photon.komoot.io/api/
GOOGLE_GEOCODE_URL=https://maps.googleapis.com/maps/api/geocode/json
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
W3W_CONVERT_URL=https://api.what3words.com/v3/convert-to-3wa
W3W_GRID_SECTION_URL=https://api.what3words.com/v3/grid-section
PHZM_API_Base_URL=https://phzmapi.org

# Grid & Spatial Defaults
DEFAULT_GRID_ROWS=18
DEFAULT_GRID_COLS=26
SQUARE_SIZE_METERS=3.0
DEFAULT_HOSE_LENGTH_FT=100
HOSE_SLACK_MULTIPLIER=1.15
DEFAULT_FALLBACK_LAT=44.2601
DEFAULT_FALLBACK_LNG=-72.5754

# Strict Tier-1 ($0.00 Personal Use) Free-Tier Hard Caps
ENFORCE_FREE_TIER_HARD_CAP=true
MAPS_MONTHLY_FREE_TIER_CAP=9500
MAPS_DAILY_SAFE_CAP=300
W3W_CACHE_TTL_SECONDS=86400
SEED_DEMO_DATA=true

# Secrets (Loaded via Secret Manager in Cloud Run or local untracked .env)
GOOGLE_MAPS_API_KEY=
W3W_API_KEY=
PERENUAL_API_KEY=
PLANTNET_API_KEY=
SESSION_SIGNING_SECRET=
